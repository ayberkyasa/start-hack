# Optional repository-root .env for make backend. Keep credentials server-side.
APP_MODE=mock
# Provider defaults to mock in mock mode and openai in practice/eval.
# APP_PROVIDER_ID=openai
# APP_MODEL_ID=your-account-model-id
# Optional frozen fallback order: a JSON array of {provider_id, model_id} pairs
# tried in order after the primary. Snapshot-hashed at launch; live modes only.
# APP_MODEL_FALLBACKS='[{"provider_id":"openai","model_id":"gpt-4o-mini"}]'
OPENAI_API_KEY=
TARGET_API_TEAM_KEY=
# Optional JSON object. Omitted fields inherit the defaults in RunLimits.
# APP_RUN_LIMITS='{"wall_seconds":300,"model_calls":8,"estimated_spend_usd_cents":50}'
# Optional local database location (default: repository data/console.sqlite3).
# APP_DATABASE_PATH=/absolute/path/to/console.sqlite3
